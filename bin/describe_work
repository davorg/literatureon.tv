#!/usr/bin/env perl

use strict;
use warnings;

use builtin qw[trim];
use feature 'say';

use OpenAPI::Client::OpenAI;
use Time::Piece;
use Encode qw[encode];

use Literature::Schema;

my $sch = Literature::Schema->get_schema;

my $count = 0;
my $works = $sch->resultset('Work');

while ($count < 20 and my $work = $works->next) {
  next if defined $work->synopsis;
  ++$count;
  my $synopsis = describe_title($work);
  $work->update({ synopsis => $synopsis });
}

sub describe_title {
  my ($work) = @_;

  my ($title, $author) = ($work->title, $work->authors->first->name);

  my $debug = 1;

  my $api_key = $ENV{"OPENAI_API_KEY"} or die "OPENAI_API_KEY is not set\n";

  my $client = OpenAPI::Client::OpenAI->new;

  my $prompt = join " ",
    'Produce a 100-200 word synopsis for the work',
    "'$title' by $author";

  my $res = $client->createChatCompletion({
    body => {
      model => 'gpt-6-luna',
      reasoning_effort => 'none',
      # model => 'gpt-4.1-nano',
      messages => [
          { role => 'system', content => 'You are someone who knows a lot about popular literature.' },
          { role => 'user', content => $prompt },
      ],
      temperature => 1.0,
    },
  });

  my $text = $res->res->json->{choices}[0]{message}{content};
  $text = encode('UTF-8', $text);

  say $text if $debug;

  return $text;
}
